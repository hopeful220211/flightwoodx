MONGODB_URI=mongodb://localhost:27017/flightwoodx
PORT=3000
JWT_SECRET=your-secret-here
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# 直连应用时保持 0；只有明确位于一层可信反向代理后才设 1
TRUST_PROXY_HOPS=0
# 设计快照请求体上限；默认 6 MB，最高可设 8 MB
JSON_BODY_MAX_BYTES=6291456
# 服务端备用 CAD 导出只读取 API 自有、经批准的 DXF 目录；留空使用 apps/api/assets/cad/parts
CAD_PARTS_DIR=

# 管理后台访问密钥（临时方案，Q3 2026 接入 RBAC 后移除）
# 本地不使用后台时留空；启用时必须使用至少 16 字节的非模板值
ADMIN_ACCESS_KEY=

# 对象存储 — RFC-012 A6/A8 + RFC-024 §4.8
# STORAGE_DRIVER=disk 本地磁盘(开发) / s3 S3兼容(COS/AWS) / oss 阿里云OSS(国内生产)
STORAGE_DRIVER=disk
# disk 驱动：上传文件对外可访问的基址（生产改用 CDN_DOMAIN）
PUBLIC_BASE_URL=http://localhost:3000
# 上传文件经 CDN 访问的域名前缀（如 https://cdn.flightwoodx.com）
CDN_DOMAIN=
# 单个封面最大 5 MB；每用户每小时最多 20 次封面上传、6 次直传凭证申请
COVER_UPLOAD_MAX_BYTES=5242880
COVER_UPLOADS_PER_HOUR=20
STS_REQUESTS_PER_HOUR=6

# --- s3 驱动（STORAGE_DRIVER=s3）---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- oss 驱动（STORAGE_DRIVER=oss）---
OSS_REGION=oss-cn-chengdu
OSS_ASSETS_BUCKET=fwx-assets       # 公共读：GLB/贴图/缩略图/封面
OSS_PRIVATE_BUCKET=fwx-private     # 私有：数据库备份
OSS_ACCESS_KEY_ID=
OSS_SECRET=
# OSS 直传 STS（浏览器直传，文件不经 ECS）：POST /api/uploads/sts
OSS_STS_ROLE_ARN=                  # acs:ram::<uid>:role/fwx-upload
OSS_STS_ACCESS_KEY_ID=             # 可选：STS 子账号；留空则复用 OSS 主 AK
OSS_STS_SECRET=

# 危险维护脚本不会读取这个模板值。确需清理时只为单条命令临时设置：
# ALLOW_DESTRUCTIVE_SCRIPTS=WIPE_DESIGNS
## Optional first-party product analytics. Disabled until privacy notice and consent UI are ready.
ANALYTICS_ENABLED=false
# Independent random secret of at least 32 bytes; never reuse JWT_SECRET. Keep on rollback for withdrawal.
ANALYTICS_SECRET=
# Comma-separated internal/test account MongoDB IDs; admin accounts are excluded automatically.
ANALYTICS_EXCLUDED_USER_IDS=
