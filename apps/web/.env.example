# API 配置
VITE_API_URL=/api

# 可选统计的版本标记（仅字母、数字、点、下划线或短横线）。
# 是否开放统计由后端 /api/analytics/config 决定；访客还需单独选择允许。
VITE_ANALYTICS_RELEASE=unknown

# 静态资产（GLB / 贴图 / 缩略图）base URL（RFC-024 §4.8）
# 留空 = 本地/自托管，路径保持 '/models/...' 由 dev server / nginx 就地服务。
# 生产指向阿里云 OSS 公共读桶或 CDN 域名，例如：
#   VITE_ASSET_BASE=https://fwx-assets.oss-cn-chengdu.aliyuncs.com
VITE_ASSET_BASE=

# 其他配置可以在此添加
